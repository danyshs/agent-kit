# typed surface of strictyaml 1.6.2 that resume-kit uses; the package ships no types
from typing import Any

class Validator: ...

class Str(Validator):
    def __init__(self) -> None: ...

class Regex(Validator):
    def __init__(self, regular_expression: str) -> None: ...

class Enum(Validator):
    def __init__(self, restricted_to: list[str]) -> None: ...

class Seq(Validator):
    def __init__(self, validator: Validator) -> None: ...

class Optional:
    def __init__(self, key: str) -> None: ...

class Map(Validator):
    def __init__(self, validator: dict[str | Optional, Validator]) -> None: ...

class YAML:
    data: Any

class YAMLError(Exception): ...

def load(yaml_string: str, schema: Validator | None = ..., label: str = ...) -> YAML: ...
