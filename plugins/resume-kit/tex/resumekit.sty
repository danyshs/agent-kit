% resume-kit markers. Each wraps the template's own call and expands to it unchanged,
% so the PDF stays the same and the parser can find sections, entries and bullets by name.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{resumekit}[2026/11/25 resume-kit markers v0.1.0]

% \rkSection{<kind>}{<section heading call>}
\newcommand{\rkSection}[2]{#2}
% \rkEntry{<slug>}{<entry heading call>}
\newcommand{\rkEntry}[2]{#2}
% \rkBullet[<id>]{<bullet call>}; the id is optional only until resume_parse.py ids fills it
\newcommand{\rkBullet}[2][]{#2}
% \rkSkillLine{<label>}{<skills line call>}, inside \rkSection{skills}
\newcommand{\rkSkillLine}[2]{#2}

\endinput
