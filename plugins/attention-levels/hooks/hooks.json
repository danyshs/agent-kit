{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v python3 >/dev/null 2>&1 || exit 0; python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/attention.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sed \"s|@PLUGIN_ROOT@|$CLAUDE_PLUGIN_ROOT|g\" \"$CLAUDE_PLUGIN_ROOT/rules/attention-levels.1.json\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
