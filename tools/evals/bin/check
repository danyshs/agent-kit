#!/usr/bin/env fish
# the one definition of done. Every step captures stdout+stderr, matches the text it must show
# and prints what it measured; a step that measured less than its floor fails. An exit code alone
# is never accepted. A stage that adds a step edits this file.
set root (path resolve (status dirname)/..)
cd $root; or exit 2

# floors: raise them when files or tests are added, never lower them. A test may skip only for a
# reason in skip_reasons (no home set up), and at most skipped_max may: the 3 real-home tests
# skip with an empty HOME. They are private-only, so the public copy allows 0
set py_files_min 38
set typed_files_min 35 # pyright reads lib/ and tests/ only
set tests_min 335 # passed, not run: skips don't count toward it
set skipped_max 0
set skip_reasons ': (no \S+ here|no \S+ on this machine|tiger-style skill is not installed)$'

function fail
    echo "check: FAIL $argv[1]"
    exit 1
end

# tools must exist before anything else runs: a missing one fails closed
for tool in uv ruff pyright jq
    command -v $tool >/dev/null 2>&1; or fail "missing $tool"
end

# ruff lint: the file count comes from ruff itself, so an empty scope cannot pass
set listed (ruff check . --show-files 2>&1)
set py_count (count (string match -r '\.py$' -- $listed))
test $py_count -ge $py_files_min; or fail "ruff scope has $py_count files, floor $py_files_min"
set out (string join \n -- (ruff check . 2>&1))
test "$out" = "All checks passed!"; or begin
    echo $out
    fail ruff-check
end
echo "check: ruff lint ok, $py_count files"

set out (string join \n -- (ruff format --check . 2>&1))
if string match -q '*would reformat*' -- $out; or not string match -qr '^[0-9]+ files? already formatted$' -- $out
    echo $out
    fail ruff-format
end
set fmt_count (string match -r '^[0-9]+' -- $out)
test $fmt_count -ge $py_files_min; or fail "ruff format saw $fmt_count files, floor $py_files_min"
echo "check: ruff format ok, $fmt_count files"

# pyright reports through --outputjson; `0 errors` is also what it prints with no files, so the
# files-analyzed count is part of the verdict. $argv: json text, floor.
function pyright_json_ok
    printf '%s' "$argv[1]" | jq -e --argjson floor "$argv[2]" \
        '.summary.errorCount == 0 and .summary.warningCount == 0 and .summary.informationCount == 0 and .summary.filesAnalyzed >= $floor' >/dev/null 2>&1
end
# the guard must be seen to trip on bad input and pass on good input
pyright_json_ok '{"summary":{"errorCount":0,"warningCount":0,"informationCount":0,"filesAnalyzed":0}}' 5; and fail 'pyright guard accepts an empty scope'
pyright_json_ok '{"summary":{"errorCount":1,"warningCount":0,"informationCount":0,"filesAnalyzed":9}}' 5; and fail 'pyright guard accepts an error'
pyright_json_ok '{"summary":{"errorCount":0,"warningCount":1,"informationCount":0,"filesAnalyzed":9}}' 5; and fail 'pyright guard accepts a warning'
pyright_json_ok '{"summary":{"errorCount":0,"warningCount":0,"informationCount":1,"filesAnalyzed":9}}' 5; and fail 'pyright guard accepts an information'
pyright_json_ok 'not json' 5; and fail 'pyright guard accepts junk'
pyright_json_ok '{"summary":{"errorCount":0,"warningCount":0,"informationCount":0,"filesAnalyzed":9}}' 5; or fail 'pyright guard rejects a clean run'

# -p: a pyrightconfig.json higher up (the repo-wide one) must not replace this project's strict config
set json (pyright -p pyproject.toml --outputjson 2>&1 | string collect)
pyright_json_ok "$json" $typed_files_min; or begin
    echo (printf '%s' "$json" | jq -c '.summary' 2>&1)
    fail "pyright (errors, warnings, or fewer than $typed_files_min files analyzed)"
end
set py_analyzed (printf '%s' "$json" | jq -r '.summary.filesAnalyzed')
echo "check: pyright ok, $py_analyzed files, 0 errors, 0 warnings"

set raw (uv run --quiet --no-project --python 3.12 --with pytest python -m pytest -q -rs 2>&1)
set rc $status
set out (string join \n -- $raw)
set last $raw[-1]
test $rc -eq 0; or begin
    echo $out
    fail pytest-exit
end
string match -qr '^[0-9]+ passed' -- $last; or begin
    echo $out
    fail pytest-summary
end
for word in failed error warning 'no tests ran'
    if string match -q "*$word*" -- $last
        echo $out
        fail "pytest-summary $word"
    end
end
set test_count (string match -r '^[0-9]+' -- $last)
test $test_count -ge $tests_min; or fail "pytest ran $test_count tests, floor $tests_min"
# a skip for any other reason, or more than the allowance, means tests went quiet
set skip_lines (string match -r '^SKIPPED .*' -- $raw)
set odd (string match -rv -- $skip_reasons $skip_lines)
test (count $odd) -eq 0; or begin
    printf '%s\n' $odd
    fail "pytest skipped tests for a reason not in skip_reasons"
end
set skipped (string match -r '([0-9]+) skipped' -- $last)[2]
test -n "$skipped"; or set skipped 0
test $skipped -eq (count $skip_lines); or fail "pytest skip count $skipped, listed "(count $skip_lines)
test $skipped -le $skipped_max; or begin
    echo $out
    fail "pytest skipped $skipped tests, at most $skipped_max"
end
echo "check: pytest ok, $test_count tests, $skipped skipped"

echo "check: ok"
